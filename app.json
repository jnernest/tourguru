{
  "expo": {
    "name": "TourGuide",
    "slug": "walk-guide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/81606f95-233f-43f7-b0b5-e65f154d3fed"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jnernest.tourguide",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TourGuide uses your location to tell you about places you walk past. It is only sent to Wikipedia to look up nearby articles and to OpenFreeMap to draw the map.",
          "locationAlwaysAndWhenInUsePermission": "TourGuide can keep telling you about places with the screen off, if you turn that on in Settings. Your location is only sent to Wikipedia to look up nearby articles and to OpenFreeMap to draw the map.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      "expo-status-bar",
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "TourGuide listens when you tap \"Ask a question\", so you can ask about the place in front of you."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "81606f95-233f-43f7-b0b5-e65f154d3fed"
      }
    },
    "owner": "jnernest",
    "scheme": "tourguide"
  }
}
