{
  "name": "walk-guide",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "expo": "~58.0.17",
    "expo-build-properties": "~58.0.11",
    "expo-location": "~58.0.18",
    "expo-speech": "~58.0.3",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/record-fixtures.ts",
    "smoke:web": "expo export --dev --platform web --output-dir .smoke-web && node scripts/smoke-web-bundle.cjs .smoke-web",
    "e2e:web": "expo export --dev --platform web --output-dir .smoke-web && node scripts/e2e-web.cjs .smoke-web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "eas:login": "npx --yes eas-cli@25.1.1 login",
    "eas:whoami": "npx --yes eas-cli@25.1.1 whoami",
    "preapk": "node scripts/lockfile-public-registry.cjs",
    "apk": "npx --yes eas-cli@25.1.1 build --platform android --profile preview",
    "update": "node scripts/eas-update.cjs",
    "apk:list": "npx --yes eas-cli@25.1.1 build:list --platform android --limit 5",
    "apk:set-key": "node scripts/set-eas-env.cjs EXPO_PUBLIC_ANTHROPIC_API_KEY",
    "apk:set-llm-key": "node scripts/set-eas-env.cjs EXPO_PUBLIC_LLM_API_KEY"
  },
  "private": true
}
