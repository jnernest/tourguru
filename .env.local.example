# Copy to .env.local (gitignored) and fill in. Restart `npm start` after changing it.

# The app gets AI stories from the TourGuide server (EAS Hosting), which holds the Gemini key.
EXPO_PUBLIC_LLM_PROXY_URL=https://tour-guide.expo.app/api/narrate

# Gemini free-tier key (https://aistudio.google.com/apikey). Server-only: `npm run proxy:set-key`
# uploads it to EAS and `npm run proxy:deploy` deploys the server. Never prefix it with EXPO_PUBLIC_.
LLM_API_KEY=

# Optional, local testing only: a key compiled into the app instead of the server.
# EXPO_PUBLIC_LLM_API_KEY=
