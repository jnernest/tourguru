# Copy to .env.local (gitignored) and fill in. Restart `npm start` after changing it.
# PERSONAL USE ONLY: keys are compiled into the app bundle. Never share a build that has them.
# For the APK, set them in EAS instead (.env.local is not uploaded): npm run apk:set-llm-key -- <key>

# Free AI narration: Google Gemini free tier (key from https://aistudio.google.com/apikey).
EXPO_PUBLIC_LLM_API_KEY=
# Optional: any other OpenAI-compatible provider, e.g. Groq:
# EXPO_PUBLIC_LLM_BASE_URL=https://api.groq.com/openai/v1
# EXPO_PUBLIC_LLM_MODEL=<model id from the provider>

# Optional, paid: Claude (used only if EXPO_PUBLIC_LLM_API_KEY is empty).
EXPO_PUBLIC_ANTHROPIC_API_KEY=
